# HTTPS for the domain (SITE: a certificate from Let's Encrypt, renewed by
# itself) and its www sent to it; without a domain, SITE is :80 (plain HTTP on
# the server's IP) and the www block a local name (www.localhost) that needs no
# certificate from outside. Both come from DOMAIN (docker-compose.yml).
{$SITE} {
	encode zstd gzip
	reverse_proxy web:80
}

{$WWW_SITE} {
	redir https://{$SITE}{uri} permanent
}
