# copy to .env next to docker-compose.yml and fill in
# the domain pointing to this server (an A record); empty: plain HTTP on the IP
DOMAIN=
# the code to create the first account (the admin); empty: a random one in `docker compose logs api`
SETUP_CODE=
# who publishes the images on GHCR (the GitHub user or organisation)
GHCR_OWNER=eirikrrrr
# what one account may have running at once in the emulator (admins: no limit)
MAX_LABS_PER_USER=3
MAX_CONTAINERS_PER_USER=24
# labs saved per account
MAX_SAVED_LABS=50
# the site's address, for the providers' way back: https://visualtracert.online
PUBLIC_URL=
# GitHub: Settings → Developer settings → OAuth Apps; callback https://<domain>/auth/oauth/github/callback
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
# Google: Cloud Console → APIs & Services → Credentials → OAuth client (Web); redirect https://<domain>/auth/oauth/google/callback
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
