#!/bin/sh
# RouterOS's CLI, over SSH on the management NIC (its password, from the
# environment), once it has booted and is configured. With arguments, runs
# them as one command (plain output).
i=0
while [ ! -e /run/vr/ready ]; do
  [ "$i" -eq 0 ] && printf 'RouterOS está arrancando, espera'
  printf '.'
  sleep 2
  i=$((i + 1))
  [ "$i" -gt 300 ] && { echo; echo 'RouterOS no arrancó: revisa vr-console.'; exit 1; }
done
[ "$i" -gt 0 ] && echo
# +t: no terminal detection (its size comes with the session), +c: no colours
user=admin+t tty=-t
[ $# -gt 0 ] && user=admin+ct tty=-T
sshpass -p "${VR_PASSWORD:-admin}" ssh -q "$tty" -p 2022 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=15 "$user@127.0.0.1" "$@"
code=$?
# 255: no session at all (its SSH does not answer), said instead of closing in silence
if [ "$code" -eq 255 ]; then
  echo
  echo 'No se pudo entrar en RouterOS por SSH. Prueba la consola serie (usuario admin, contraseña admin)'
  echo 'o vuelve a desplegar el laboratorio.'
  sleep 1
fi
exit "$code"
