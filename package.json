{
  "name": "visualtracert-canvas",
  "private": true,
  "version": "0.5.0",
  "stage": "alpha",
  "description": "El lienzo de redes de visual-tracert: editor visual de topologías, simulación de paquetes y emulación con equipos reales, como herramienta local.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @visual-tracert/web",
    "build": "npm run build -w @visual-tracert/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
