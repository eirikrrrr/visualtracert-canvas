{
  "name": "visual-tracert",
  "private": true,
  "version": "0.3.0",
  "description": "Laboratorio de redes en el navegador: editor visual de topologías y simulación de paquetes.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @visual-tracert/web",
    "build": "npm run build -w @visual-tracert/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
